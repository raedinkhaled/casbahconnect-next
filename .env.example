# Application URL and session signing
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# MongoDB (used by Mongoose and the NextAuth adapter)
MONGODB_URL=mongodb://127.0.0.1:27017/casbah-connect

# Resend SMTP credentials
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_replace_with_resend_api_key
EMAIL_FROM=Casbah Connect <auth@example.com>

# TinyMCE browser editor key
NEXT_PUBLIC_TINY_EDITOR_API_KEY=replace-with-tinymce-api-key

